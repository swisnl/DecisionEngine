# PHPStan support for swisnl/decision-engine. Loaded automatically by phpstan/extension-installer,
# otherwise add `includes: [vendor/swisnl/decision-engine/extension.neon]` to your phpstan.neon.
services:
    -
        class: Swis\DecisionEngine\PHPStan\TypedOutcomePropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension
